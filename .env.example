# ==============================================================================
# BAN CHỈNH ĐẠO DIGITAL LIBRARY — BIẾN MÔI TRƯỜNG MẪU (.env.example)
# Lưu ý: Không lưu trữ mật khẩu/secret thật vào tệp này hoặc commit tệp .env lên Git.
# ==============================================================================

# 1. ỨNG DỤNG CHUNG
NODE_ENV=development
API_PORT=4000
WEB_PORT=3000

# 2. CƠ SỞ DỮ LIỆU POSTGRESQL + POSTGIS (Docker Service)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_dev
POSTGRES_DB=caodai_digital_library
POSTGRES_PORT=5432
DATABASE_URL="postgresql://postgres:postgres_password_dev@localhost:5432/caodai_digital_library?schema=public"

# 3. BỘ NHỚ ĐỆM & HÀNG ĐỢI REDIS
REDIS_HOST=localhost
REDIS_PORT=6379

# 4. KHO LƯU TRỮ ĐỐI TƯỢNG S3 / MINIO
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_password_dev
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_BUCKET_NAME=caodai-scans
S3_ACCESS_KEY=minio_admin
S3_SECRET_KEY=minio_password_dev

# 5. BẢO MẬT & XÁC THỰC (JWT)
JWT_SECRET=super_secret_jwt_key_change_me_in_production
JWT_EXPIRES_IN=7d

