// Prisma Schema cho Ban Chinh Dao Digital Library
// Hỗ trợ PostgreSQL 16 + PostGIS Extension

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// 1. NGƯỜI DÙNG & XÁC THỰC (Users & Auth)
// ==========================================

enum UserStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

model User {
  id           String      @id @default(uuid()) @db.Uuid
  email        String      @unique @db.VarChar(255)
  passwordHash String      @map("password_hash") @db.VarChar(255)
  fullName     String      @map("full_name") @db.VarChar(150)
  phoneNumber  String?     @map("phone_number") @db.VarChar(20)
  status       UserStatus  @default(ACTIVE)
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt    DateTime?   @map("deleted_at") @db.Timestamptz

  // Quan hệ
  roleAssignments     UserRoleAssignment[]
  auditLogs           AuditLog[]
  calendarPreferences UserCalendarPreference?

  @@map("users")
}

// ==========================================
// 2. PHÂN QUYỀN CÓ PHẠM VI (Scoped RBAC)
// ==========================================

enum RoleCode {
  VISITOR
  MEMBER
  UNIT_ADMIN
  LIBRARY_EDITOR
  REVIEWER
  SYSTEM_ADMIN
}

model Role {
  id          String    @id @default(uuid()) @db.Uuid
  code        RoleCode  @unique
  name        String    @db.VarChar(100)
  description String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  // Quan hệ
  rolePermissions RolePermission[]
  userAssignments UserRoleAssignment[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(100)
  module      String   @db.VarChar(50)
  description String?  @db.Text

  // Quan hệ
  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRoleAssignment {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  roleId      String   @map("role_id") @db.Uuid
  scopeUnitId String?  @map("scope_unit_id") @db.Uuid
  scopeSiteId String?  @map("scope_site_id") @db.Uuid
  assignedBy  String?  @map("assigned_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@map("user_role_assignments")
}

// ==========================================
// 3. TÙY CHỌN LỊCH CÁ NHÂN & TRAI KỲ
// ==========================================

enum FastingScheduleMode {
  NONE
  LUC_TRAI
  THAP_TRAI
  THIEN_NGUON
}

model UserCalendarPreference {
  id                String              @id @default(uuid()) @db.Uuid
  userId            String              @unique @map("user_id") @db.Uuid
  showCanChi        Boolean             @default(true) @map("show_can_chi")
  fastingSchedule   FastingScheduleMode @default(NONE) @map("fasting_schedule")
  highlightTramSoc  Boolean             @default(true) @map("highlight_tram_soc")
  updatedAt         DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_calendar_preferences")
}

// ==========================================
// 4. KIỂM TOÁN HỆ THỐNG (Audit Logging)
// ==========================================

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  PUBLISH
  LOGIN
  LOGOUT
}

model AuditLog {
  id            String      @id @default(uuid()) @db.Uuid
  userId        String?     @map("user_id") @db.Uuid
  action        AuditAction
  entityName    String      @map("entity_name") @db.VarChar(50)
  entityId      String?     @map("entity_id") @db.VarChar(100)
  oldValuesJson Json?       @map("old_values_json")
  newValuesJson Json?       @map("new_values_json")
  ipAddress     String?     @map("ip_address") @db.VarChar(45)
  userAgent     String?     @map("user_agent") @db.Text
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityName, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ==========================================
// 5. PHÂN HỆ LỊCH ĐẠO & SỰ KIỆN (Religious Calendar)
// ==========================================

enum EventCategory {
  MAJOR_HOLIDAY        // Đại lễ tôn giáo
  COMMEMORATION        // Lễ kỷ niệm tôn giáo, tiền bối
  TRADITIONAL_FESTIVAL // Lễ hội truyền thống dân gian
  NATIONAL_HOLIDAY     // Ngày lễ lớn của Nhà nước Việt Nam
}

model ReligiousEvent {
  id          String        @id @default(uuid()) @db.Uuid
  code        String        @unique @db.VarChar(100)
  title       String        @db.VarChar(255)
  description String?       @db.Text
  category    EventCategory @default(MAJOR_HOLIDAY)
  isRecurring Boolean       @default(true) @map("is_recurring")

  rules       CalendarRule[]
  occurrences EventOccurrence[]

  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  @@map("religious_events")
}

model CalendarRule {
  id              String         @id @default(uuid()) @db.Uuid
  eventId         String         @map("event_id") @db.Uuid
  event           ReligiousEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  
  isLunar         Boolean        @default(true) @map("is_lunar")
  lunarMonth      Int?           @map("lunar_month")
  lunarDayStart   Int?           @map("lunar_day_start")
  lunarDayEnd     Int?           @map("lunar_day_end")
  solarMonth      Int?           @map("solar_month")
  solarDayStart   Int?           @map("solar_day_start")
  solarDayEnd     Int?           @map("solar_day_end")
  applyLeapMonth  Boolean        @default(false) @map("apply_leap_month")
  dateRangeStr    String?        @map("date_range_str") @db.VarChar(100) // Ví dụ: "08 – 09/01 Âm lịch"

  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz

  @@map("calendar_rules")
}

model EventOccurrence {
  id             String         @id @default(uuid()) @db.Uuid
  eventId        String         @map("event_id") @db.Uuid
  event          ReligiousEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  solarDate      DateTime       @map("solar_date") @db.Date
  lunarDateStr   String         @map("lunar_date_str") @db.VarChar(50)
  canChiDay      String?        @map("can_chi_day") @db.VarChar(50)
  canChiMonth    String?        @map("can_chi_month") @db.VarChar(50)
  canChiYear     String?        @map("can_chi_year") @db.VarChar(50)
  
  isMajorHoliday Boolean        @default(false) @map("is_major_holiday")
  notes          String?        @db.Text

  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz

  @@unique([eventId, solarDate])
  @@index([solarDate])
  @@map("event_occurrences")
}

// ==========================================
// 3. TỔ ĐÌNH BẾN TRE & CƠ SỞ THỜ TỰ (Phase 2)
// ==========================================

enum SiteType {
  TOA_THANH
  DIEN_THO_PHAT_MAU
  VUON_KY_THO
  NHA_TU_TRUNG_THUA
  NHA_TU_THUONG_THUA
  NHA_TU_TRUNG_THUA_NAM
  NHA_TU_TRUNG_THUA_NU
  NHA_TU_THUONG_THUA_NAM
  NHA_TU_THUONG_THUA_NU
  THANH_THAT
  HO_DAO
  OTHER_SITE
}

enum VisibilityLevel {
  PUBLIC_FEATURED
  PUBLIC_COMPACT
  INTERNAL_ONLY
}

enum SiteSectionType {
  HISTORY
  ARCHITECTURE
  DIRECTIONS
}

enum VerificationStatus {
  UNVERIFIED
  PENDING_VERIFICATION
  VERIFIED
  OFFICIALLY_CONFIRMED
}

model OrganizationUnit {
  id              String             @id @default(uuid()) @db.Uuid
  parentId        String?            @map("parent_id") @db.Uuid
  parent          OrganizationUnit?  @relation("OrgUnitHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children        OrganizationUnit[] @relation("OrgUnitHierarchy")

  name            String             @db.VarChar(200)
  unitType        String             @map("unit_type") @db.VarChar(50) // HOI_THANH, BAN_TRI_SU, HO_DAO, OTHER
  establishedYear Int?               @map("established_year")

  worshipSites    WorshipSite[]

  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  @@map("organization_units")
}

model WorshipSite {
  id                 String              @id @default(uuid()) @db.Uuid
  orgUnitId          String?             @map("org_unit_id") @db.Uuid
  orgUnit            OrganizationUnit?   @relation(fields: [orgUnitId], references: [id], onDelete: SetNull)

  slug               String              @unique @db.VarChar(120)
  name               String              @db.VarChar(200)
  otherNames         String[]            @default([]) @map("other_names")
  siteType           SiteType            @map("site_type")

  isFeaturedLandmark Boolean             @default(false) @map("is_featured_landmark")
  visibilityLevel    VisibilityLevel     @default(INTERNAL_ONLY) @map("visibility_level")
  displayOrder       Int                 @default(0) @map("display_order")

  province           String?             @db.VarChar(100)
  currentAddress     String              @map("current_address") @db.Text
  historicAddress    String?             @map("historic_address") @db.Text
  directionsSummary  String?             @map("directions_summary") @db.Text
  latitude           Float?
  longitude          Float?
  imageUrl           String?             @map("image_url") @db.VarChar(255)
  imageCaption       String?             @map("image_caption") @db.VarChar(255)

  verificationStatus VerificationStatus  @default(PENDING_VERIFICATION) @map("verification_status")
  sourceNote         String?             @map("source_note") @db.Text
  verifiedBy         String?             @map("verified_by") @db.Uuid
  verifiedAt         DateTime?           @map("verified_at") @db.Timestamptz

  sections           SiteDetailSection[]

  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt          DateTime?           @map("deleted_at") @db.Timestamptz

  @@index([visibilityLevel, isFeaturedLandmark, displayOrder])
  @@index([siteType])
  @@map("worship_sites")
}

model SiteDetailSection {
  id                 String             @id @default(uuid()) @db.Uuid
  siteId             String             @map("site_id") @db.Uuid
  site               WorshipSite        @relation(fields: [siteId], references: [id], onDelete: Cascade)

  sectionType        SiteSectionType    @map("section_type")
  title              String             @db.VarChar(200)
  contentMarkdown    String             @map("content_markdown") @db.Text
  sortOrder          Int                @default(0) @map("sort_order")

  sourceCitation     String?            @map("source_citation") @db.Text
  verificationStatus VerificationStatus @default(PENDING_VERIFICATION) @map("verification_status")

  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  @@index([siteId, sectionType, sortOrder])
  @@map("site_detail_sections")
}



